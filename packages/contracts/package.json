{
  "name": "@orderline/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
