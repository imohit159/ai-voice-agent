HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=data/agent.sqlite
# Default AI approach for new workspaces; the dashboard setting wins afterwards.
VOICE_PROVIDER=gemini
GEMINI_LIVE_MODEL=gemini-3.8-live
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3

# --- Voice agent (services/voice-agent) -------------------------------------
# Shared secret both services use on their internal APIs (min 32 chars).
VOICE_AGENT_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
# How the API reaches the voice agent, and how the voice agent reaches the API.
VOICE_AGENT_INTERNAL_URL=http://127.0.0.1:7860
API_INTERNAL_URL=http://127.0.0.1:3000
VOICE_AGENT_HOST=127.0.0.1
VOICE_AGENT_PORT=7860
VOICE_AGENT_LOG_LEVEL=INFO
# AI provider keys are read only by the voice agent.
GEMINI_API_KEY=
# Model API subscription key from dashboard.sarvam.ai/key-management
SARVAM_API_KEY=
# ----------------------------------------------------------------------------
TEST_PHONE_NUMBER=+919625532959
STORE_NAME=Demo Store
AGENT_LANGUAGE=Hindi and English
# plivo places real calls and requires every PLIVO_* value, PUBLIC_BASE_URL and
# VOICE_AGENT_STREAM_URL. simulated places no calls (local development only).
TELEPHONY_PROVIDER=simulated
# Plivo Console → Account overview. Never put these in the browser.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# KYC-approved Plivo number used as caller ID, E.164 (+91XXXXXXXXXX).
PLIVO_FROM_NUMBER=
# Public HTTPS origin Plivo sends call callbacks to (your domain or a tunnel).
PUBLIC_BASE_URL=
# Public WSS URL of the voice agent's /plivo/stream endpoint (Plivo signs this exact URL).
# Plivo credentials above are shared: the voice agent uses them to verify the stream
# and hang up calls it ends.
VOICE_AGENT_STREAM_URL=
MAX_CONCURRENT_CALLS=10
MAX_CALL_SECONDS=180
# Shared HMAC secret for signed call requests from the business system (min 32 chars).
# Blank disables POST /integrations/v1/call-requests.
INTEGRATION_INBOUND_SECRET=
# Approved destination for signed call results (HTTPS; plain HTTP only for localhost).
# Local mock: http://127.0.0.1:4010/results (run `pnpm mock:business serve`).
INTEGRATION_RESULT_URL=
INTEGRATION_RESULT_SECRET=
# Calling hours in IST, [start, end), and minutes to wait before attempts 2 and 3.
CALLING_HOURS_START=10
CALLING_HOURS_END=19
CALL_RETRY_DELAYS_MINUTES=30,120
