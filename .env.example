HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=data/agent.sqlite
VOICE_PROVIDER=gemini
# Model API subscription key from dashboard.sarvam.ai/key-management
SARVAM_API_KEY=
# Optional managed Voice Agents platform key; separate from Model APIs and MCP OAuth
SARVAM_VOICE_AGENTS_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
TEST_PHONE_NUMBER=+919625532959
STORE_NAME=Demo Store
AGENT_LANGUAGE=Hindi and English
# Set these from Exotel Dashboard → API credentials. Never put secrets in the browser.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_REGION=in
# Optional App Bazaar Voicebot flow. Blank uses direct Connect Voice AI.
EXOTEL_FLOW_ID=
# Exotel must reach this HTTPS origin and its WSS endpoint (e.g. your tunnel).
PUBLIC_BASE_URL=
# Explicitly enable after credentials and the public URL are configured.
ENABLE_PHONE_CALLS=false
MAX_CONCURRENT_CALLS=10
MAX_CALL_SECONDS=180
# Shared HMAC secret for signed call requests from the business system (min 32 chars).
# Blank disables POST /integrations/v1/call-requests.
INTEGRATION_INBOUND_SECRET=
# Approved destination for signed call results (HTTPS; plain HTTP only for localhost).
# Local mock: http://127.0.0.1:4010/results (run `pnpm mock:business serve`).
INTEGRATION_RESULT_URL=
INTEGRATION_RESULT_SECRET=
# Calling hours in IST, [start, end), and minutes to wait before attempts 2 and 3.
CALLING_HOURS_START=10
CALLING_HOURS_END=19
CALL_RETRY_DELAYS_MINUTES=30,120
