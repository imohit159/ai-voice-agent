{
  "name": "@orderline/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "node scripts/check-boundaries.mjs && tsc --noEmit && node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "node scripts/check-boundaries.mjs && tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "mock:business": "node --import tsx scripts/mock-business-system.ts"
  },
  "dependencies": {
    "@orderline/contracts": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "fastify": "5.12.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
