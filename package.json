{
  "name": "order-care-voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @orderline/contracts build && pnpm --filter @orderline/api --filter @orderline/contracts --parallel run dev",
    "dev:api": "pnpm dev",
    "dev:web": "pnpm --filter @orderline/contracts build && pnpm --filter @orderline/web dev",
    "dev:all": "pnpm --filter @orderline/contracts build && pnpm -r --parallel run dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @orderline/api start",
    "check": "pnpm --filter @orderline/contracts build && pnpm -r check",
    "test": "pnpm --filter @orderline/contracts build && pnpm --filter @orderline/api test",
    "check:gemini": "pnpm --filter @orderline/contracts build && pnpm --filter @orderline/api check:gemini",
    "check:voice": "pnpm --filter @orderline/contracts build && pnpm --filter @orderline/api check:voice"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
